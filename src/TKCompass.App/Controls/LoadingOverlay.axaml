<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TKCompass.ViewModels"
             x:Class="TKCompass.Controls.LoadingOverlay"
             x:DataType="vm:CreatorDashboardViewModel">
    <Border Background="#80000000" IsVisible="{Binding IsLoading}">
        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
            <ProgressBar IsIndeterminate="True" Width="200" Height="4"/>
            <TextBlock Text="加载中..." Margin="0,10,0,0" HorizontalAlignment="Center" Foreground="White"/>
        </StackPanel>
    </Border>
</UserControl>
