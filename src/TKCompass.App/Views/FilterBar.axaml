<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TKCompass.ViewModels"
             x:Class="TKCompass.Views.FilterBar"
             x:DataType="vm:FilterViewModel">
    
    <Border Background="#2D2D30" CornerRadius="5" Padding="15">
        <StackPanel Spacing="10">
            <TextBlock Text="筛选" FontSize="14" FontWeight="Bold" Foreground="White"/>
            
            <WrapPanel Orientation="Horizontal" Margin="0,5">
                <StackPanel Margin="0,0,15,5">
                    <TextBlock Text="达人ID" FontSize="11" Foreground="#B0B0B0"/>
                    <TextBox Text="{Binding HandleSearch}" Width="150" Watermark="搜索达人ID"/>
                </StackPanel>
                
                <StackPanel Margin="0,0,15,5">
                    <TextBlock Text="状态" FontSize="11" Foreground="#B0B0B0"/>
                    <ComboBox ItemsSource="{Binding StatusOptions}" 
                              SelectedItem="{Binding SelectedStatus}" Width="120"/>
                </StackPanel>
                
                <StackPanel Margin="0,0,15,5">
                    <TextBlock Text="等级" FontSize="11" Foreground="#B0B0B0"/>
                    <ComboBox ItemsSource="{Binding QualityLevelOptions}" 
                              SelectedItem="{Binding SelectedQualityLevel}" Width="80"/>
                </StackPanel>
                
                <StackPanel Margin="0,0,15,5">
                    <TextBlock Text="寄样日期从" FontSize="11" Foreground="#B0B0B0"/>
                    <DatePicker SelectedDate="{Binding SampleDateFrom}" Width="130"/>
                </StackPanel>
                
                <StackPanel Margin="0,0,15,5">
                    <TextBlock Text="寄样日期到" FontSize="11" Foreground="#B0B0B0"/>
                    <DatePicker SelectedDate="{Binding SampleDateTo}" Width="130"/>
                </StackPanel>
                
                <StackPanel Margin="0,0,15,5">
                    <TextBlock Text="联系日期从" FontSize="11" Foreground="#B0B0B0"/>
                    <DatePicker SelectedDate="{Binding ContactDateFrom}" Width="130"/>
                </StackPanel>
                
                <StackPanel Margin="0,0,15,5">
                    <TextBlock Text="联系日期到" FontSize="11" Foreground="#B0B0B0"/>
                    <DatePicker SelectedDate="{Binding ContactDateTo}" Width="130"/>
                </StackPanel>
                
                <StackPanel Margin="0,0,15,5">
                    <TextBlock Text="产品名" FontSize="11" Foreground="#B0B0B0"/>
                    <TextBox Text="{Binding ProductNameSearch}" Width="150" Watermark="搜索产品名"/>
                </StackPanel>
            </WrapPanel>
        </StackPanel>
    </Border>
</UserControl>
