<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TKCompass.ViewModels"
             x:Class="TKCompass.Views.BatchRemindLogView"
             x:DataType="vm:BatchRemindLogViewModel">
    
    <Design.DataContext>
        <vm:BatchRemindLogViewModel />
    </Design.DataContext>
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- 顶部工具栏 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="批量提醒日志" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
            <Button Content="刷新" Command="{Binding RefreshCommand}" Margin="20,0,0,0"/>
        </StackPanel>
        
        <!-- 日志列表 -->
        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding Logs}"
                  SelectedItem="{Binding SelectedLog}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="80"/>
                <DataGridTextColumn Header="批次号" Binding="{Binding BatchNumber}" Width="150"/>
                <DataGridTextColumn Header="提醒时间" Binding="{Binding RemindTime, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" Width="200"/>
                <DataGridTextColumn Header="提醒人" Binding="{Binding RemindUser}" Width="150"/>
                <DataGridTextColumn Header="提醒内容" Binding="{Binding RemindContent}" Width="*"/>
                <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
