<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TKCompass.ViewModels"
             x:Class="TKCompass.Views.AllCreatorsView"
             x:DataType="vm:AllCreatorsViewModel">
    <Design.DataContext>
        <vm:AllCreatorsViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- 页面标题 -->
        <TextBlock Grid.Row="0" Text="达人总表" FontSize="24" FontWeight="Bold" Margin="20,16,20,8"/>

        <!-- 工具栏：筛选栏 + 操作按钮 -->
        <Border Grid.Row="0" Background="#F5F5F5" CornerRadius="6" Padding="15,10" Margin="20,50,20,8">
            <Grid ColumnDefinitions="*,Auto">
                <!-- 左侧：筛选控件 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Text="状态筛选：" VerticalAlignment="Center"/>
                    <ComboBox SelectedItem="{Binding SelectedOverviewStatus}" Width="150">
                        <ComboBoxItem Content="全部"/>
                        <ComboBoxItem Content="Unreached"/>
                        <ComboBoxItem Content="Reached"/>
                        <ComboBoxItem Content="CooperationSent"/>
                        <ComboBoxItem Content="CooperationAgreed"/>
                        <ComboBoxItem Content="SampleSent"/>
                    </ComboBox>
                    <TextBlock Text="{Binding FilteredCreators.Count, StringFormat='共 {0} 条'}"
                               VerticalAlignment="Center" Foreground="Gray" Margin="10,0,0,0"/>
                </StackPanel>
                
                <!-- 右侧：操作按钮（右对齐） -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                    <Button Content="新建达人" Command="{Binding CreateCreatorCommand}" 
                            Padding="12,6" Background="#4CAF50" Foreground="White"/>
                    <Button Content="刷新" Command="{Binding RefreshCommand}" 
                            Padding="12,6"/>
                    <Button Content="应用筛选" Command="{Binding ApplyFilterCommand}" 
                            Padding="12,6" Background="#2196F3" Foreground="White"/>
                    <Button Content="清除筛选" Command="{Binding ClearFilterCommand}" 
                            Padding="12,6"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 数据表格 -->
        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding FilteredCreators}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserSortColumns="True"
                  GridLinesVisibility="Horizontal"
                  SelectionMode="Extended"
                  Margin="20,10"
                  SelectionChanged="DataGrid_SelectionChanged"
                  DoubleTapped="DataGrid_DoubleTapped">
            <DataGrid.Columns>
                <DataGridTextColumn Header="达人ID" Binding="{Binding Handle}" Width="120"/>
                <DataGridTextColumn Header="昵称" Binding="{Binding Nickname}" Width="150"/>
                <DataGridTextColumn Header="等级" Binding="{Binding QualityLevel}" Width="60"/>
                <DataGridTextColumn Header="合作状态" Binding="{Binding CooperationStatus}" Width="120"/>
                <DataGridTextColumn Header="首次寄样" Binding="{Binding FirstSampleDate, StringFormat='{}{0:yyyy-MM-dd}'}" Width="100"/>
                <DataGridTextColumn Header="最近联系" Binding="{Binding LatestContactDate, StringFormat='{}{0:yyyy-MM-dd}'}" Width="100"/>
                <DataGridTextColumn Header="备注" Binding="{Binding CreatorNotes}" Width="*"/>
                <DataGridTemplateColumn Header="操作" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="删除"
                                    Command="{Binding $parent[DataGrid].DataContext.DeletePermanentlyCommand}"
                                    CommandParameter="{Binding}"
                                    Padding="8,3" Background="#F44336" Foreground="White"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 底部状态栏 -->
        <Border Grid.Row="2" Background="#F5F5F5" Padding="10">
            <StackPanel Orientation="Horizontal" Spacing="15">
                <TextBlock Text="{Binding FilteredCreators.Count, StringFormat='显示 {0} 条'}"
                           VerticalAlignment="Center" Foreground="Gray"/>
                <Button Content="批量删除" Command="{Binding BatchDeleteCommand}" Padding="10,5"
                        IsEnabled="{Binding HasSelection}"/>
                <Button Content="批量恢复" Command="{Binding BatchRestoreCommand}" Padding="10,5"
                        IsEnabled="{Binding HasSelection}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
