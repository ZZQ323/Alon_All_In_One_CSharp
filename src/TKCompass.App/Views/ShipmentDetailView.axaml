<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TKCompass.ViewModels"
             x:Class="TKCompass.Views.ShipmentDetailView"
             x:DataType="vm:ShipmentDetailViewModel">
    
    <Design.DataContext>
        <vm:ShipmentDetailViewModel />
    </Design.DataContext>
    
    <ScrollViewer>
        <StackPanel Margin="20" Spacing="20">
            <!-- 寄样基本信息 -->
            <Border Background="#2D2D30" CornerRadius="5" Padding="15">
                <StackPanel Spacing="10">
                    <TextBlock Text="寄样信息" FontSize="18" FontWeight="Bold" Foreground="White"/>
                    
                    <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="10">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="寄样ID:" Foreground="#B0B0B0"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Shipment.Id}" Foreground="White"/>
                        
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="达人ID:" Foreground="#B0B0B0"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Shipment.CreatorId}" Foreground="White"/>
                        
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="快递单号:" Foreground="#B0B0B0"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Shipment.TrackingNumber}" Foreground="White"/>
                        
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="寄样日期:" Foreground="#B0B0B0"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Shipment.SampleDate, StringFormat='{}{0:yyyy-MM-dd}'}" Foreground="White"/>
                        
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="备注:" Foreground="#B0B0B0"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Shipment.Notes}" Foreground="White" TextWrapping="Wrap"/>
                    </Grid>
                </StackPanel>
            </Border>
            
            <!-- 视频列表 -->
            <Border Background="#2D2D30" CornerRadius="5" Padding="15">
                <StackPanel Spacing="10">
                    <TextBlock Text="相关视频" FontSize="18" FontWeight="Bold" Foreground="White"/>
                    
                    <DataGrid ItemsSource="{Binding Videos}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              GridLinesVisibility="Horizontal"
                              Height="300">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="视频ID" Binding="{Binding Id}" Width="80"/>
                            <DataGridTextColumn Header="视频链接" Binding="{Binding VideoUrl}" Width="*"/>
                            <DataGridTextColumn Header="上传日期" Binding="{Binding UploadDate, StringFormat='{}{0:yyyy-MM-dd}'}" Width="120"/>
                            <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
