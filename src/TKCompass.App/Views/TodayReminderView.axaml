<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TKCompass.ViewModels"
             x:Class="TKCompass.Views.TodayReminderView"
             x:DataType="vm:TodayReminderViewModel">
    <Design.DataContext>
        <vm:TodayReminderViewModel />
    </Design.DataContext>
    
    <DockPanel Margin="20">
        <TextBlock DockPanel.Dock="Top" Text="{Binding Title}" 
                   FontSize="24" FontWeight="Bold" Margin="0,0,0,16"/>
        <TextBlock Text="今日暂无需要提醒的达人" 
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="Gray" FontSize="16"/>
    </DockPanel>
</UserControl>
