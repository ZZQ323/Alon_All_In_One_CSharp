<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TKCompass.ViewModels"
             x:Class="TKCompass.Views.TodayReminderView"
             x:DataType="vm:TodayReminderViewModel">
    <Design.DataContext>
        <vm:TodayReminderViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="20,10">
            <TextBlock Text="今日提醒" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>
            <Button Content="刷新" Command="{Binding RefreshCommand}" Padding="10,5"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="20,0,20,20">
            <StackPanel Spacing="15">
                <!-- 触达组 -->
                <Expander Header="{Binding UnreachedCreators.Count, StringFormat='触达 ({0})'}" IsExpanded="True">
                    <DataGrid ItemsSource="{Binding UnreachedCreators}" AutoGenerateColumns="False" IsReadOnly="True" Height="200">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="达人ID" Binding="{Binding Handle}" Width="100"/>
                            <DataGridTextColumn Header="昵称" Binding="{Binding Nickname}" Width="120"/>
                            <DataGridTextColumn Header="等级" Binding="{Binding QualityLevel}" Width="50"/>
                            <DataGridTextColumn Header="状态" Binding="{Binding CooperationStatus}" Width="100"/>
                            <DataGridTemplateColumn Header="操作" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <Button Content="推进状态" Command="{Binding $parent[DataGrid].DataContext.AdvanceStatusCommand}" CommandParameter="{Binding}" Padding="6,2" Background="#2196F3" Foreground="White"/>
                                            <Button Content="标记已提醒" Command="{Binding $parent[DataGrid].DataContext.MarkRemindedCommand}" CommandParameter="{Binding}" Padding="6,2" Background="#4CAF50" Foreground="White"/>
                                            <Button Content="暂不合作" Command="{Binding $parent[DataGrid].DataContext.MarkNoCooperationCommand}" CommandParameter="{Binding}" Padding="6,2" Background="#F44336" Foreground="White"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Expander>

                <!-- 同意合作组 -->
                <Expander Header="{Binding AgreedCreators.Count, StringFormat='同意合作 ({0})'}" IsExpanded="True">
                    <DataGrid ItemsSource="{Binding AgreedCreators}" AutoGenerateColumns="False" IsReadOnly="True" Height="200">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="达人ID" Binding="{Binding Handle}" Width="100"/>
                            <DataGridTextColumn Header="昵称" Binding="{Binding Nickname}" Width="120"/>
                            <DataGridTextColumn Header="等级" Binding="{Binding QualityLevel}" Width="50"/>
                            <DataGridTemplateColumn Header="操作" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <Button Content="推进状态" Command="{Binding $parent[DataGrid].DataContext.AdvanceStatusCommand}" CommandParameter="{Binding}" Padding="6,2" Background="#2196F3" Foreground="White"/>
                                            <Button Content="标记已提醒" Command="{Binding $parent[DataGrid].DataContext.MarkRemindedCommand}" CommandParameter="{Binding}" Padding="6,2" Background="#4CAF50" Foreground="White"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Expander>

                <!-- 已寄样组 -->
                <Expander Header="{Binding SampleSentCreators.Count, StringFormat='已寄样 ({0})'}" IsExpanded="True">
                    <DataGrid ItemsSource="{Binding SampleSentCreators}" AutoGenerateColumns="False" IsReadOnly="True" Height="200">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="达人ID" Binding="{Binding Handle}" Width="100"/>
                            <DataGridTextColumn Header="昵称" Binding="{Binding Nickname}" Width="120"/>
                            <DataGridTextColumn Header="等级" Binding="{Binding QualityLevel}" Width="50"/>
                            <DataGridTextColumn Header="首次寄样" Binding="{Binding FirstSampleDate, StringFormat='{}{0:yyyy-MM-dd}'}" Width="100"/>
                            <DataGridTemplateColumn Header="操作" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <Button Content="标记已提醒" Command="{Binding $parent[DataGrid].DataContext.MarkRemindedCommand}" CommandParameter="{Binding}" Padding="6,2" Background="#4CAF50" Foreground="White"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Expander>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
