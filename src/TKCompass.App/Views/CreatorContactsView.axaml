<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TKCompass.ViewModels"
             x:Class="TKCompass.Views.CreatorContactsView"
             x:DataType="vm:CreatorContactsViewModel">
    
    <StackPanel Spacing="10">
        <TextBlock Text="联系方式" FontSize="16" FontWeight="Bold" Foreground="White"/>
        
        <!-- 已有联系方式列表 -->
        <ItemsControl ItemsSource="{Binding Contacts}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnDefinitions="120,*,Auto" Margin="0,5">
                        <TextBlock Text="{Binding ContactType}" Foreground="#B0B0B0" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Text="{Binding ContactValue}" Margin="10,0"/>
                        <Button Grid.Column="2" Content="删除" 
                                Command="{Binding $parent[ItemsControl].((vm:CreatorContactsViewModel)DataContext).DeleteContactCommand}"
                                CommandParameter="{Binding}"
                                Background="#FF4444" Foreground="White" Padding="10,5"/>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        
        <!-- 添加新联系方式 -->
        <Border Background="#2D2D30" CornerRadius="5" Padding="10" Margin="0,10,0,0">
            <StackPanel Spacing="10">
                <TextBlock Text="添加新联系方式" FontSize="14" Foreground="#B0B0B0"/>
                <Grid ColumnDefinitions="120,*,Auto">
                    <ComboBox Grid.Column="0" ItemsSource="{Binding AvailableContactTypes}" 
                              SelectedItem="{Binding NewContactType}" 
                              PlaceholderText="选择类型"/>
                    <TextBox Grid.Column="1" Text="{Binding NewContactValue}" 
                             Watermark="输入联系方式" Margin="10,0,0,0"/>
                    <Button Grid.Column="2" Content="添加" 
                            Command="{Binding AddContactCommand}"
                            Background="#0078D4" Foreground="White" Padding="15,5"/>
                </Grid>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
