<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:TKCompass.ViewModels"
        xmlns:views="using:TKCompass.Views"
        x:Class="TKCompass.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="TKCompass - 达人管理系统"
        Width="1200" Height="800">
    
    <Window.KeyBindings>
        <KeyBinding Gesture="F5" Command="{Binding RefreshCommand}"/>
        <KeyBinding Gesture="Ctrl+R" Command="{Binding RefreshCommand}"/>
    </Window.KeyBindings>
    
    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>
    
    <DockPanel>
        <!-- 状态栏 -->
        <TextBlock DockPanel.Dock="Bottom"
                   Text="{Binding StatusBarMessage}" 
                   Background="{DynamicResource SecondarySurfaceBrush}" 
                   Foreground="{DynamicResource SecondaryTextBrush}"
                   Padding="10,4" FontSize="12"/>
        
        <!-- 主内容区 -->
        <Grid ColumnDefinitions="200,*">
            <!-- 左侧导航栏 -->
            <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}">
                <StackPanel Margin="0,20,0,0">
                    <TextBlock Text="TKCompass" 
                               FontSize="20" 
                               FontWeight="Bold" 
                               Margin="20,0,20,20"/>
                    
                    <Expander Header="达人工作台" 
                              HorizontalAlignment="Stretch" 
                              HorizontalContentAlignment="Left" 
                              Margin="10,5">
                        <StackPanel>
                            <Button Content="今日提醒" 
                                    Command="{Binding NavigateToTodayReminderCommand}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    Margin="20,2,0,2">
                                <Button.Styles>
                                    <Style Selector="Button.selected">
                                        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Style>
                                </Button.Styles>
                            </Button>
                            <Button Content="正在交付" 
                                    Command="{Binding NavigateToInDeliveryCommand}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    Margin="20,2,0,2">
                                <Button.Styles>
                                    <Style Selector="Button.selected">
                                        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Style>
                                </Button.Styles>
                            </Button>
                            <Button Content="总表" 
                                    Command="{Binding NavigateToAllCreatorsCommand}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    Margin="20,2,0,2">
                                <Button.Styles>
                                    <Style Selector="Button.selected">
                                        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Style>
                                </Button.Styles>
                            </Button>
                            <Button Content="已交付" 
                                    Command="{Binding NavigateToDeliveredCommand}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    Margin="20,2,0,2">
                                <Button.Styles>
                                    <Style Selector="Button.selected">
                                        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Style>
                                </Button.Styles>
                            </Button>
                            <Button Content="已删除" 
                                    Command="{Binding NavigateToDeletedCommand}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    Margin="20,2,0,2">
                                <Button.Styles>
                                    <Style Selector="Button.selected">
                                        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Style>
                                </Button.Styles>
                            </Button>
                        </StackPanel>
                    </Expander>
                    
                    <Button Content="CRM 管理" 
                            Command="{Binding NavigateToCrmCommand}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Margin="10,5"/>
                    
                    <Button Content="Excel 导入" 
                            Command="{Binding NavigateToExcelImportCommand}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Margin="10,5"/>
                    
                    <Button Content="配置管理" 
                            Command="{Binding NavigateToConfigCommand}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Margin="10,5"/>
                    
                    <Button Content="操作历史" 
                            Command="{Binding NavigateToOperationHistoryCommand}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Margin="10,5"/>
                    
                    <Button Content="设置" 
                            Command="{Binding NavigateToSettingsCommand}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Margin="10,5"/>
                </StackPanel>
            </Border>
            
            <!-- 右侧内容区 -->
            <Border Grid.Column="1" Background="{DynamicResource BackgroundBrush}">
                <ContentControl Content="{Binding CurrentView}"/>
            </Border>
        </Grid>
    </DockPanel>
</Window>
