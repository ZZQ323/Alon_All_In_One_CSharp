<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:TKCompass.ViewModels"
        x:Class="TKCompass.Views.ConfigEditDialog"
        Title="编辑配置" Width="400" Height="300"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Design.DataContext>
        <vm:ConfigEditDialogViewModel />
    </Design.DataContext>

    <StackPanel Margin="20" Spacing="15">
        <TextBox Name="CodeTextBox"
                 Text="{Binding Code}"
                 Watermark="{Binding CodeWatermark}"
                 IsVisible="{Binding ShowCode}"
                 Height="35"/>
        <TextBox Name="NameTextBox"
                 Text="{Binding Name}"
                 Watermark="{Binding NameWatermark}"
                 Height="35"/>
        <TextBox Name="DescriptionTextBox"
                 Text="{Binding Description}"
                 Watermark="{Binding DescriptionWatermark}"
                 Height="35"/>
        <TextBox Name="SortOrderTextBox"
                 Text="{Binding SortOrder}"
                 Watermark="排序（数字）"
                 IsVisible="{Binding ShowSortOrder}"
                 Height="35"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,10,0,0">
            <Button Content="取消" Name="CancelButton" Height="35" Padding="20,0"/>
            <Button Content="确定" Name="OkButton" Classes="accent" Height="35" Padding="20,0"/>
        </StackPanel>
    </StackPanel>
</Window>
