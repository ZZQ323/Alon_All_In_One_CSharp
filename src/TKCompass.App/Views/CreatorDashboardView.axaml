<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TKCompass.ViewModels"
             xmlns:views="using:TKCompass.Views"
             xmlns:controls="using:TKCompass.Controls"
             x:Class="TKCompass.Views.CreatorDashboardView"
             x:DataType="vm:CreatorDashboardViewModel">

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- 顶部统计栏 -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" Padding="15">
            <StackPanel Orientation="Horizontal" Spacing="30">
                <StackPanel>
                    <TextBlock Text="总达人" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <TextBlock Text="{Binding TotalCount}" FontSize="20" FontWeight="Bold" Foreground="White"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="已交付" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <TextBlock Text="{Binding DeliveredCount}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="已删除" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <TextBlock Text="{Binding DeletedCount}" FontSize="20" FontWeight="Bold" Foreground="#F44336"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="已提醒" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <TextBlock Text="{Binding RemindedCount}" FontSize="20" FontWeight="Bold" Foreground="#2196F3"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="正在交付" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <TextBlock Text="{Binding DeliveringCount}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="今日跟进" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <TextBlock Text="{Binding TodayFollowUpCount}" FontSize="20" FontWeight="Bold" Foreground="#E91E63"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 主内容区：筛选栏 + TabControl -->
        <Grid Grid.Row="1" RowDefinitions="Auto,*">
            <!-- 筛选栏 -->
            <views:FilterBar Grid.Row="0" DataContext="{Binding Filter}" Margin="15,15,15,0"/>

            <!-- TabControl -->
            <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex}" Margin="15">
                <TabItem Header="总表">
                    <DataGrid x:Name="MainDataGrid"
                              ItemsSource="{Binding FilteredCreators}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserReorderColumns="True"
                              CanUserResizeColumns="True"
                              GridLinesVisibility="Horizontal"
                              BorderThickness="0"
                              SelectionMode="Extended"
                              SelectionChanged="DataGrid_SelectionChanged"
                              DoubleTapped="DataGrid_DoubleTapped">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="达人ID" Binding="{Binding Handle}" Width="120"/>
                            <DataGridTextColumn Header="昵称" Binding="{Binding Nickname}" Width="150"/>
                            <DataGridTextColumn Header="等级" Binding="{Binding QualityLevel}" Width="60"/>
                            <DataGridTextColumn Header="合作状态" Binding="{Binding CooperationStatus}" Width="100"/>
                            <DataGridTextColumn Header="首次寄样" Binding="{Binding FirstSampleDate, StringFormat='{}{0:yyyy-MM-dd}'}" Width="100"/>
                            <DataGridTextColumn Header="最近联系" Binding="{Binding LatestContactDate, StringFormat='{}{0:yyyy-MM-dd}'}" Width="100"/>
                            <DataGridTextColumn Header="备注" Binding="{Binding CreatorNotes}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

                <TabItem Header="已交付">
                    <DataGrid ItemsSource="{Binding DeliveredCreators}" 
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              GridLinesVisibility="Horizontal"
                              BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="达人ID" Binding="{Binding Handle}" Width="120"/>
                            <DataGridTextColumn Header="昵称" Binding="{Binding Nickname}" Width="150"/>
                            <DataGridTextColumn Header="等级" Binding="{Binding QualityLevel}" Width="60"/>
                            <DataGridTextColumn Header="交付原因" Binding="{Binding DeliveredReason}" Width="*"/>
                            <DataGridTextColumn Header="首次寄样" Binding="{Binding FirstSampleDate, StringFormat='{}{0:yyyy-MM-dd}'}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

                <TabItem Header="已删除">
                    <DataGrid ItemsSource="{Binding DeletedCreators}" 
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              GridLinesVisibility="Horizontal"
                              BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="达人ID" Binding="{Binding Handle}" Width="120"/>
                            <DataGridTextColumn Header="昵称" Binding="{Binding Nickname}" Width="150"/>
                            <DataGridTextColumn Header="等级" Binding="{Binding QualityLevel}" Width="60"/>
                            <DataGridTextColumn Header="删除原因" Binding="{Binding DeliveredReason}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

                <TabItem Header="已提醒">
                    <DataGrid ItemsSource="{Binding RemindedCreators}" 
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              GridLinesVisibility="Horizontal"
                              BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="达人ID" Binding="{Binding Handle}" Width="120"/>
                            <DataGridTextColumn Header="昵称" Binding="{Binding Nickname}" Width="150"/>
                            <DataGridTextColumn Header="等级" Binding="{Binding QualityLevel}" Width="60"/>
                            <DataGridTextColumn Header="合作状态" Binding="{Binding CooperationStatus}" Width="100"/>
                            <DataGridTextColumn Header="最近联系" Binding="{Binding LatestContactDate, StringFormat='{}{0:yyyy-MM-dd}'}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

                <TabItem Header="正在交付">
                    <DataGrid ItemsSource="{Binding DeliveringCreators}" 
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              GridLinesVisibility="Horizontal"
                              BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="达人ID" Binding="{Binding Handle}" Width="120"/>
                            <DataGridTextColumn Header="昵称" Binding="{Binding Nickname}" Width="150"/>
                            <DataGridTextColumn Header="等级" Binding="{Binding QualityLevel}" Width="60"/>
                            <DataGridTextColumn Header="首次寄样" Binding="{Binding FirstSampleDate, StringFormat='{}{0:yyyy-MM-dd}'}" Width="100"/>
                            <DataGridTextColumn Header="备注" Binding="{Binding CreatorNotes}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

                <TabItem Header="今日提醒">
                    <DataGrid ItemsSource="{Binding TodayFollowUpCreators}" 
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              GridLinesVisibility="Horizontal"
                              BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="达人ID" Binding="{Binding Handle}" Width="120"/>
                            <DataGridTextColumn Header="昵称" Binding="{Binding Nickname}" Width="150"/>
                            <DataGridTextColumn Header="等级" Binding="{Binding QualityLevel}" Width="60"/>
                            <DataGridTextColumn Header="合作状态" Binding="{Binding CooperationStatus}" Width="100"/>
                            <DataGridTextColumn Header="最近联系" Binding="{Binding LatestContactDate, StringFormat='{}{0:yyyy-MM-dd}'}" Width="100"/>
                            <DataGridTextColumn Header="备注" Binding="{Binding CreatorNotes}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
            </TabControl>
        </Grid>

        <!-- 底部状态栏 -->
        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" Padding="10">
            <StackPanel Orientation="Horizontal" Spacing="20">
                <TextBlock Text="{Binding FilteredCreators.Count, StringFormat='显示 {0} 条'}"
                           Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12"/>
                <Button Content="刷新" Command="{Binding RefreshCommand}" Padding="10,5"
                        IsEnabled="{Binding !IsLoading}"/>
                <Button Content="应用筛选" Command="{Binding ApplyFilterCommand}" Padding="10,5"
                        IsEnabled="{Binding !IsLoading}"/>
                <Button Content="清除筛选" Command="{Binding ClearFilterCommand}" Padding="10,5"
                        IsEnabled="{Binding !IsLoading}"/>
                <Button Content="批量删除" Command="{Binding BatchDeleteCommand}" Padding="10,5">
                    <Button.IsEnabled>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="HasSelection"/>
                            <Binding Path="!IsLoading"/>
                        </MultiBinding>
                    </Button.IsEnabled>
                </Button>
                <Button Content="批量恢复" Command="{Binding BatchRestoreCommand}" Padding="10,5">
                    <Button.IsEnabled>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="HasSelection"/>
                            <Binding Path="!IsLoading"/>
                        </MultiBinding>
                    </Button.IsEnabled>
                </Button>
            </StackPanel>
        </Border>

        <!-- 加载遮罩层 -->
        <controls:LoadingOverlay Grid.RowSpan="3"/>
    </Grid>
</UserControl>
