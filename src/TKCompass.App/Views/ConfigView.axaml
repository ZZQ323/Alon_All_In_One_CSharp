<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TKCompass.ViewModels"
             x:Class="TKCompass.Views.ConfigView"
             x:DataType="vm:ConfigViewModel">

    <Design.DataContext>
        <vm:ConfigViewModel />
    </Design.DataContext>

    <Panel>
        <!-- 主内容 -->
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 标题和刷新按钮 -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="配置管理" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>
            <Button Content="刷新" Command="{Binding RefreshCommand}" HorizontalAlignment="Right" Padding="15,8"/>
        </Grid>

        <!-- 错误提示 -->
        <Border Grid.Row="1" IsVisible="{Binding HasError}" 
                Background="{DynamicResource ErrorBrush}" CornerRadius="5" Padding="10" Margin="0,0,0,10">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="White" TextWrapping="Wrap"/>
        </Border>

        <!-- 配置 TabControl -->
        <TabControl Grid.Row="2">
            <!-- 达人类型 -->
            <TabItem Header="达人类型">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,0,0,10">
                        <Button Content="新增达人类型" Command="{Binding AddCreatorTypeCommand}" Classes="accent" Padding="15,8"/>
                        <Button Content="编辑选中" Command="{Binding EditCreatorTypeCommand}" Padding="15,8"/>
                        <Button Content="删除选中" Command="{Binding DeleteCreatorTypeCommand}" Padding="15,8"/>
                    </StackPanel>
                    <DataGrid Grid.Row="1" Name="CreatorTypeDataGrid"
                              ItemsSource="{Binding CreatorTypes}"
                              SelectedItem="{Binding SelectedCreatorType}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserReorderColumns="True"
                              CanUserResizeColumns="True"
                              GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="80"/>
                            <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="200"/>
                            <DataGridTextColumn Header="描述" Binding="{Binding Description}" Width="*"/>
                            <DataGridTextColumn Header="创建时间" Binding="{Binding CreatedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" Width="180"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- 产品代码 -->
            <TabItem Header="产品代码">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,0,0,10">
                        <Button Content="新增产品代码" Command="{Binding AddProductCodeCommand}" Classes="accent" Padding="15,8"/>
                        <Button Content="编辑选中" Command="{Binding EditProductCodeCommand}" Padding="15,8"/>
                        <Button Content="删除选中" Command="{Binding DeleteProductCodeCommand}" Padding="15,8"/>
                    </StackPanel>
                    <DataGrid Grid.Row="1" Name="ProductCodeDataGrid"
                              ItemsSource="{Binding ProductCodes}"
                              SelectedItem="{Binding SelectedProductCode}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserReorderColumns="True"
                              CanUserResizeColumns="True"
                              GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="80"/>
                            <DataGridTextColumn Header="代码" Binding="{Binding Code}" Width="150"/>
                            <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="200"/>
                            <DataGridTextColumn Header="描述" Binding="{Binding Description}" Width="*"/>
                            <DataGridTextColumn Header="创建时间" Binding="{Binding CreatedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" Width="180"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- 质量等级 -->
            <TabItem Header="质量等级">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,0,0,10">
                        <Button Content="新增质量等级" Command="{Binding AddQualityLevelCommand}" Classes="accent" Padding="15,8"/>
                        <Button Content="编辑选中" Command="{Binding EditQualityLevelCommand}" Padding="15,8"/>
                        <Button Content="删除选中" Command="{Binding DeleteQualityLevelCommand}" Padding="15,8"/>
                    </StackPanel>
                    <DataGrid Grid.Row="1" Name="QualityLevelDataGrid"
                              ItemsSource="{Binding QualityLevels}"
                              SelectedItem="{Binding SelectedQualityLevel}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserReorderColumns="True"
                              CanUserResizeColumns="True"
                              GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="80"/>
                            <DataGridTextColumn Header="代码" Binding="{Binding Code}" Width="100"/>
                            <DataGridTextColumn Header="标签" Binding="{Binding Label}" Width="150"/>
                            <DataGridTextColumn Header="排序" Binding="{Binding SortOrder}" Width="100"/>
                            <DataGridTextColumn Header="创建时间" Binding="{Binding CreatedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- 联系方式渠道 -->
            <TabItem Header="联系方式渠道">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,0,0,10">
                        <Button Content="新增联系方式渠道" Command="{Binding AddContactChannelCommand}" Classes="accent" Padding="15,8"/>
                        <Button Content="编辑选中" Command="{Binding EditContactChannelCommand}" Padding="15,8"/>
                        <Button Content="删除选中" Command="{Binding DeleteContactChannelCommand}" Padding="15,8"/>
                    </StackPanel>
                    <DataGrid Grid.Row="1" Name="ContactChannelDataGrid"
                              ItemsSource="{Binding ContactChannels}"
                              SelectedItem="{Binding SelectedContactChannel}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserReorderColumns="True"
                              CanUserResizeColumns="True"
                              GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="80"/>
                            <DataGridTextColumn Header="代码" Binding="{Binding Code}" Width="150"/>
                            <DataGridTextColumn Header="标签" Binding="{Binding Label}" Width="200"/>
                            <DataGridTextColumn Header="排序" Binding="{Binding SortOrder}" Width="100"/>
                            <DataGridTextColumn Header="创建时间" Binding="{Binding CreatedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
        </Grid>
        
        <!-- 加载遮罩 -->
        <Border Background="#80000000" IsVisible="{Binding IsLoading}" ZIndex="99">
            <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="200" Height="4"/>
                <TextBlock Text="加载中..." Margin="0,10,0,0" Foreground="White" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Panel>
</UserControl>
