<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TKCompass.ViewModels"
             x:Class="TKCompass.Views.TodayFollowUpView"
             x:DataType="vm:TodayFollowUpViewModel">
    
    <Design.DataContext>
        <vm:TodayFollowUpViewModel />
    </Design.DataContext>
    
    <Grid RowDefinitions="Auto,Auto,*">
        <!-- 顶部筛选区 -->
        <Border Grid.Row="0" Background="#2D2D30" Padding="15">
            <StackPanel>
                <TextBlock Text="今日跟进" FontSize="20" FontWeight="Bold" Foreground="White" Margin="0,0,0,15"/>
                
                <WrapPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                        <TextBlock Text="从：" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="#B0B0B0"/>
                        <DatePicker SelectedDate="{Binding FromDate}" Width="150"/>
                    </StackPanel>
                    
                    <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                        <TextBlock Text="至：" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="#B0B0B0"/>
                        <DatePicker SelectedDate="{Binding ToDate}" Width="150"/>
                    </StackPanel>
                    
                    <Button Content="搜索" Command="{Binding SearchCommand}" Margin="0,0,10,0"/>
                    <Button Content="重置" Command="{Binding ResetCommand}"/>
                </WrapPanel>
                
                <!-- 统计标签 -->
                <StackPanel Orientation="Horizontal" Spacing="30">
                    <StackPanel>
                        <TextBlock Text="总数" FontSize="12" Foreground="#B0B0B0"/>
                        <TextBlock Text="{Binding TotalCount}" FontSize="20" FontWeight="Bold" Foreground="White"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="待处理" FontSize="12" Foreground="#B0B0B0"/>
                        <TextBlock Text="{Binding PendingCount}" FontSize="20" FontWeight="Bold" Foreground="#FF9800"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="已确认" FontSize="12" Foreground="#B0B0B0"/>
                        <TextBlock Text="{Binding AcknowledgedCount}" FontSize="20" FontWeight="Bold" Foreground="#4CAF50"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>
        
        <!-- 分页控制 -->
        <Border Grid.Row="1" Background="#1E1E1E" Padding="10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="20">
                <Button Content="上一页" Command="{Binding PreviousPageCommand}" 
                        IsEnabled="{Binding CurrentPage, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                <TextBlock Text="{Binding PageInfo}" VerticalAlignment="Center" Foreground="#B0B0B0"/>
                <Button Content="下一页" Command="{Binding NextPageCommand}" 
                        IsEnabled="{Binding CurrentPage, Converter={x:Static ObjectConverters.IsNotNull}}"/>
            </StackPanel>
        </Border>
        
        <!-- 分组展示区 -->
        <ScrollViewer Grid.Row="2">
            <ItemsControl x:Name="OuterItemsControl" ItemsSource="{Binding FollowUpGroups}" Margin="15">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#2D2D30" CornerRadius="5" Padding="15" Margin="0,0,0,15">
                            <StackPanel>
                                <TextBlock Text="{Binding Reason}" FontSize="16" FontWeight="Bold" 
                                           Foreground="White" Margin="0,0,0,10"/>
                                
                                <ItemsControl ItemsSource="{Binding Items}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#1E1E1E" CornerRadius="3" Padding="10" Margin="0,0,0,5">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Foreground="White" FontWeight="SemiBold">
                                                            <Run Text="{Binding Creator.Handle}"/>
                                                            <Run Text=" - "/>
                                                            <Run Text="{Binding Creator.Nickname}"/>
                                                        </TextBlock>
                                                        
                                                        <TextBlock Text="{Binding FollowUpReason}" 
                                                                   Foreground="#B0B0B0" FontSize="12" 
                                                                   Margin="0,5,0,0"/>
                                                        
                                                        <StackPanel Orientation="Horizontal" Spacing="15" Margin="0,5,0,0">
                                                            <TextBlock Foreground="#888888" FontSize="11">
                                                                <Run Text="等级: "/>
                                                                <Run Text="{Binding Creator.QualityLevel}"/>
                                                            </TextBlock>
                                                            <TextBlock Foreground="#888888" FontSize="11">
                                                                <Run Text="寄样数: "/>
                                                                <Run Text="{Binding Shipments.Count}"/>
                                                            </TextBlock>
                                                            <TextBlock Foreground="#888888" FontSize="11">
                                                                <Run Text="视频数: "/>
                                                                <Run Text="{Binding Videos.Count}"/>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </StackPanel>
                                                    
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" 
                                                                Spacing="5" VerticalAlignment="Center">
                                                        <Button Content="确认" 
                                                                Command="{Binding $parent[UserControl].DataContext.MarkAsAcknowledgedCommand}"
                                                                CommandParameter="{Binding}"/>
                                                        <Button Content="完成" 
                                                                Command="{Binding $parent[UserControl].DataContext.MarkAsCompletedCommand}"
                                                                CommandParameter="{Binding}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
